# Cross-OS build image for Wails v3 desktop apps
#
# Darwin: Zig + macOS SDK
# Linux: Native GCC + native GTK/WebKit libraries; target CPU must match the image
# Windows: Zig + bundled mingw
#
# Usage:
# From the repository root (not src):
#   wails3 task common:build:frontend
#   docker build -t quarry-wails-cross -f src/build/docker/Dockerfile.cross src/build/docker
#   docker run --rm -v $(pwd):/app quarry-wails-cross darwin arm64
#   docker run --rm -v $(pwd):/app quarry-wails-cross darwin amd64
#   docker run --rm -v $(pwd):/app quarry-wails-cross linux amd64  # amd64 image only
#   docker run --rm -v $(pwd):/app quarry-wails-cross linux arm64  # arm64 image only
#   docker run --rm -v $(pwd):/app quarry-wails-cross windows amd64
#   docker run --rm -v $(pwd):/app quarry-wails-cross windows arm64

FROM golang:1.27.1-trixie@sha256:433790e515d27dc6003e847e644cc0af956985cf315c1c58a3b73ee2dd305183

ARG TARGETARCH

# TARGETARCH is supplied by BuildKit for the selected image platform. Do not
# silently treat a missing or unsupported value as amd64: Linux builds use the
# image's native compiler and system libraries.
RUN case "${TARGETARCH}" in \
        amd64|arm64) ;; \
        *) echo "unsupported or missing Docker TARGETARCH: ${TARGETARCH}" >&2; exit 1 ;; \
    esac

# Install base tools, GCC, and GTK/WebKit dev packages
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl xz-utils pkg-config gcc libc6-dev \
    libgtk-3-dev libwebkit2gtk-4.1-dev \
    libgtk-4-dev libwebkitgtk-6.0-dev \
    && rm -rf /var/lib/apt/lists/*

# Wails beta.23 uses GTK APIs introduced in 4.14. Keep the image from building
# successfully with headers that compile tests but cannot link the application.
RUN pkg-config --atleast-version=4.14 gtk4 \
    && pkg-config --exists webkitgtk-6.0

# Garble v0.18.0 supports Go 1.27, but Quarry's obfuscated bindings and native
# packages still need qualification. Reject OBFUSCATED explicitly in build.sh
# until that validation is complete and the tool is pinned here.

# Install a checksum-pinned Zig archive for the image's host architecture.
ARG ZIG_VERSION=0.16.0
RUN ZIG_ARCH=$(case "${TARGETARCH}" in arm64) echo "aarch64" ;; amd64) echo "x86_64" ;; *) exit 1 ;; esac) && \
    ZIG_FILE="zig-${ZIG_ARCH}-linux-${ZIG_VERSION}.tar.xz" && \
    curl -fSL "https://ziglang.org/download/${ZIG_VERSION}/${ZIG_FILE}" -o "/tmp/${ZIG_FILE}" && \
    EXPECTED=$(case "${ZIG_ARCH}" in \
        aarch64) echo "ea4b09bfb22ec6f6c6ceac57ab63efb6b46e17ab08d21f69f3a48b38e1534f17" ;; \
        x86_64) echo "70e49664a74374b48b51e6f3fdfbf437f6395d42509050588bd49abe52ba3d00" ;; \
        *) exit 1 ;; \
    esac) && \
    echo "${EXPECTED}  /tmp/${ZIG_FILE}" | sha256sum -c - && \
    tar -xJ -f "/tmp/${ZIG_FILE}" -C /opt && \
    rm "/tmp/${ZIG_FILE}" && \
    ln -s /opt/zig-${ZIG_ARCH}-linux-${ZIG_VERSION}/zig /usr/local/bin/zig

# Download macOS SDK (required for darwin targets)
ARG MACOS_SDK_VERSION=26.1
ARG MACOS_SDK_SHA256=beee7212d265a6d2867d0236cc069314b38d5fb3486a6515734e76fa210c784c
RUN SDK_FILE="MacOSX${MACOS_SDK_VERSION}.sdk.tar.xz" && \
    curl -fL "https://github.com/joseluisq/macosx-sdks/releases/download/${MACOS_SDK_VERSION}/${SDK_FILE}" -o "/tmp/${SDK_FILE}" && \
    echo "${MACOS_SDK_SHA256}  /tmp/${SDK_FILE}" | sha256sum -c - && \
    tar -xJ -f "/tmp/${SDK_FILE}" -C /opt && \
    rm "/tmp/${SDK_FILE}" \
    && mv /opt/MacOSX${MACOS_SDK_VERSION}.sdk /opt/macos-sdk

ENV MACOS_SDK_PATH=/opt/macos-sdk

# Create Zig CC wrappers for cross-compilation targets
# Darwin and Windows use Zig. Linux uses native GCC and native development
# libraries, so the requested Linux architecture must match the image itself.

# Darwin arm64
COPY <<'ZIGWRAP' /usr/local/bin/zcc-darwin-arm64
#!/bin/sh
ARGS=""
SKIP_NEXT=0
for arg in "$@"; do
    if [ $SKIP_NEXT -eq 1 ]; then
        SKIP_NEXT=0
        continue
    fi
    case "$arg" in
        -target) SKIP_NEXT=1 ;;
        -mmacosx-version-min=*|-mmacos-version-min=*) ;;
        *) ARGS="$ARGS $arg" ;;
    esac
done
exec zig cc -fno-sanitize=all -target aarch64-macos-none -mmacos-version-min=13.0 -isysroot /opt/macos-sdk -I/opt/macos-sdk/usr/include -L/opt/macos-sdk/usr/lib -F/opt/macos-sdk/System/Library/Frameworks -w $ARGS
ZIGWRAP
RUN chmod +x /usr/local/bin/zcc-darwin-arm64

# Darwin amd64
COPY <<'ZIGWRAP' /usr/local/bin/zcc-darwin-amd64
#!/bin/sh
ARGS=""
SKIP_NEXT=0
for arg in "$@"; do
    if [ $SKIP_NEXT -eq 1 ]; then
        SKIP_NEXT=0
        continue
    fi
    case "$arg" in
        -target) SKIP_NEXT=1 ;;
        -mmacosx-version-min=*|-mmacos-version-min=*) ;;
        *) ARGS="$ARGS $arg" ;;
    esac
done
exec zig cc -fno-sanitize=all -target x86_64-macos-none -mmacos-version-min=13.0 -isysroot /opt/macos-sdk -I/opt/macos-sdk/usr/include -L/opt/macos-sdk/usr/lib -F/opt/macos-sdk/System/Library/Frameworks -w $ARGS
ZIGWRAP
RUN chmod +x /usr/local/bin/zcc-darwin-amd64

# Windows amd64 - uses Zig's bundled mingw
COPY <<'ZIGWRAP' /usr/local/bin/zcc-windows-amd64
#!/bin/sh
ARGS=""
SKIP_NEXT=0
for arg in "$@"; do
    if [ $SKIP_NEXT -eq 1 ]; then
        SKIP_NEXT=0
        continue
    fi
    case "$arg" in
        -target) SKIP_NEXT=1 ;;
        -Wl,*) ;;
        *) ARGS="$ARGS $arg" ;;
    esac
done
exec zig cc -target x86_64-windows-gnu $ARGS
ZIGWRAP
RUN chmod +x /usr/local/bin/zcc-windows-amd64

# Windows arm64 - uses Zig's bundled mingw
COPY <<'ZIGWRAP' /usr/local/bin/zcc-windows-arm64
#!/bin/sh
ARGS=""
SKIP_NEXT=0
for arg in "$@"; do
    if [ $SKIP_NEXT -eq 1 ]; then
        SKIP_NEXT=0
        continue
    fi
    case "$arg" in
        -target) SKIP_NEXT=1 ;;
        -Wl,*) ;;
        *) ARGS="$ARGS $arg" ;;
    esac
done
exec zig cc -target aarch64-windows-gnu $ARGS
ZIGWRAP
RUN chmod +x /usr/local/bin/zcc-windows-arm64

# Build script
COPY <<'SCRIPT' /usr/local/bin/build.sh
#!/bin/sh
set -e

OS=${1:-darwin}
ARCH=${2:-arm64}

case "${OS}-${ARCH}" in
    darwin-arm64|darwin-aarch64)
        export CC=zcc-darwin-arm64
        export GOARCH=arm64
        export GOOS=darwin
        export MACOSX_DEPLOYMENT_TARGET=13.0
        ;;
    darwin-amd64|darwin-x86_64)
        export CC=zcc-darwin-amd64
        export GOARCH=amd64
        export GOOS=darwin
        export MACOSX_DEPLOYMENT_TARGET=13.0
        ;;
    linux-arm64|linux-aarch64)
        export CC=gcc
        export GOARCH=arm64
        export GOOS=linux
        ;;
    linux-amd64|linux-x86_64)
        export CC=gcc
        export GOARCH=amd64
        export GOOS=linux
        ;;
    windows-arm64|windows-aarch64)
        export CC=zcc-windows-arm64
        export GOARCH=arm64
        export GOOS=windows
        ;;
    windows-amd64|windows-x86_64)
        export CC=zcc-windows-amd64
        export GOARCH=amd64
        export GOOS=windows
        ;;
    *)
        echo "Usage: <os> <arch>"
        echo "  os: darwin, linux, windows"
        echo "  arch: amd64, arm64"
        exit 1
        ;;
esac

if [ "${OBFUSCATED:-false}" = "true" ]; then
    echo "obfuscated builds are disabled: Garble v0.18.0 has not completed Quarry obfuscation qualification; use a normal build until obfuscation qualification is complete" >&2
    exit 1
fi

export CGO_ENABLED=1
export CGO_CFLAGS="-w"

# The Task pipeline builds and tests the frontend on the host before invoking
# this cross-compiler. Failing here is safer than resolving a second dependency
# graph inside the image or compiling without generated bindings.
if [ ! -f "frontend/dist/index.html" ]; then
    echo "src/frontend/dist is missing; run 'wails3 task common:build:frontend' before cross-compiling" >&2
    exit 1
fi

# Build
APP=${APP_NAME:-quarry}
mkdir -p /app/bin

EXT=""
LDFLAGS="-s -w"
if [ "$GOOS" = "windows" ]; then
    EXT=".exe"
    LDFLAGS="-s -w -H windowsgui"
fi
LDFLAGS="$LDFLAGS -X=github.com/quarry/quarry-wails3/internal/buildinfo.Version=${APP_VERSION:-0.0.0-dev} -X=github.com/quarry/quarry-wails3/internal/buildinfo.Commit=${BUILD_COMMIT:-unknown} -X=github.com/quarry/quarry-wails3/internal/buildinfo.BuildDate=${BUILD_DATE:-unknown}"

TAGS="production"
if [ -n "$EXTRA_TAGS" ]; then
    TAGS="${TAGS},${EXTRA_TAGS}"
fi

go build -tags "$TAGS" -trimpath -buildvcs=false -ldflags="$LDFLAGS" -o "/app/bin/${APP}-${GOOS}-${GOARCH}${EXT}" .
echo "Built: /app/bin/${APP}-${GOOS}-${GOARCH}${EXT}"
SCRIPT
RUN chmod +x /usr/local/bin/build.sh

WORKDIR /app/src
ENTRYPOINT ["/usr/local/bin/build.sh"]
CMD ["darwin", "arm64"]
