<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="quarry.exe"
        Arguments=""
        InstallLocation="C:\Program Files\RCooLeR\Quarry">
    </Installer>
    <PackageInformation
        PackageName="com.rcooler.quarry"
        PackageDisplayName="Quarry"
        PublisherName="CN=RCooLeR"
        PublisherDisplayName="RCooLeR"
        Version="0.0.1.0"
        PackageDescription="Windows-first desktop editor and toolkit for very large text files.">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="com.rcooler.quarry"
                Description="Windows-first desktop editor and toolkit for very large text files."
                DisplayName="Quarry"
                ExecutableName="quarry.exe"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>Quarry</DisplayName>
            <PublisherDisplayName>RCooLeR</PublisherDisplayName>
            <Description>Windows-first desktop editor and toolkit for very large text files.</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="quarry.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
