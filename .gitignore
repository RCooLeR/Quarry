.task
bin
dist/
release-artifacts/
# Local IDE state and review/tool scratch output.
.idea/
.codex-gotmp-*/
col-review/
frontend/dist
frontend/node_modules
# TypeScript incremental compiler state is machine-local build output.
*.tsbuildinfo
build/linux/appimage/build
build/windows/nsis/MicrosoftEdgeWebview2Setup.exe
# Windows resources are generated from the checked-in icon, manifest, and
# version template for each build. They are build outputs, not source inputs.
wails_windows_*.syso
# Mobile generated (per-machine; overlays hold absolute paths)
build/ios/xcode/overlay.json
build/ios/xcode/gen/
build/android/overlay.json
build/android/gen/

# Wails-generated Go<->TS bindings (regenerated by `wails3 generate bindings`)
frontend/bindings

# Legacy CSV scratch artifacts from older builds. Current CSV writers do not
# create these names, but crash debris from a prior build must never be committed.
*.quarry-part
*.quarry-part.xlsx
