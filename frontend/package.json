{
  "name": "quarry-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "npm@12.0.2",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0",
    "npm": "12.0.2"
  },
  "scripts": {
    "dev": "node scripts/check-privileged-webview.mjs && vite",
    "check:security": "node scripts/check-privileged-webview.mjs",
    "build:dev": "node scripts/check-privileged-webview.mjs && tsc && vite build --minify false --mode development",
    "build": "node scripts/check-privileged-webview.mjs && tsc && vite build --mode production && node scripts/check-bundle-budget.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:a11y": "vitest run tests/AxeAccessibility.test.ts"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.0",
    "@codemirror/language": "6.12.4",
    "@codemirror/merge": "6.12.2",
    "@codemirror/state": "6.7.1",
    "@codemirror/view": "6.43.9",
    "@wailsio/runtime": "3.0.0-beta.15",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "axe-core": "4.13.0",
    "jsdom": "30.0.1",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
